{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fgvm installation registry v1",
  "type": "object",
  "required": [
    "default",
    "installations"
  ],
  "properties": {
    "default": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastScanDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lastLegacyScanDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "installations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/installation"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "installation": {
      "type": "object",
      "required": [
        "path",
        "installedAt",
        "lastLaunchedAt"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "installedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "lastLaunchedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
