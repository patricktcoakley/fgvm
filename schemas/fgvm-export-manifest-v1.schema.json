{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fgvm export manifest v1",
  "type": "object",
  "required": [
    "manifestVersion",
    "runId",
    "godot",
    "targets"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "godot": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "preset",
          "platform",
          "mode",
          "kind",
          "path"
        ],
        "properties": {
          "preset": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "release",
              "pack"
            ]
          },
          "kind": {
            "enum": [
              "file",
              "directory"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
