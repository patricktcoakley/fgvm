<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>15</LangVersion>
        <Authors>Patrick T Coakley</Authors>
        <PackageProjectUrl>https://github.com/patricktcoakley/fgvm</PackageProjectUrl>
        <PackageLicenseUrl>https://github.com/patricktcoakley/fgvm/blob/main/LICENSE</PackageLicenseUrl>
        <AssemblyName>fgvm-core</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Fgvm.Tests"/>
        <InternalsVisibleTo Include="fgvm"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Fgvm.Extensions"/>
    </ItemGroup>

</Project>
